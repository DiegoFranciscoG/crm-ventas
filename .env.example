# Copia este archivo a .env (o ejecuta ./scripts/init-env.sh) y completa los valores. .env NUNCA se sube a GitHub.
# Los secretos no tienen valor por defecto: si faltan, la aplicación y docker compose no arrancan.

# Base de datos (en compose es el contenedor "db"; en producción, Neon)
DB_USER=crm
DB_PASSWORD=
# Solo al ejecutar el backend fuera de Docker:
DB_URL=jdbc:postgresql://localhost:5432/crm

# Firma de JWT: al menos 32 bytes aleatorios -> openssl rand -base64 48
JWT_SECRET=
# Duración del token (ISO-8601, máx. 2 h)
JWT_TTL=PT30M
# Cifrado AES-256-GCM de la cédula: exactamente 32 bytes en Base64 -> openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Token del cron externo de recordatorios: al menos 32 bytes -> openssl rand -base64 48
CRON_TOKEN=

# Orígenes permitidos (separados por coma, sin '*')
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4200

# Administrador inicial (opcional; se crea solo si no existe ningún ADMIN). Contraseña de 12 a 72 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo: log | smtp | brevo
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@example.com
# Solo con MAIL_PROVIDER=brevo (producción):
BREVO_API_KEY=

# Puertos del host para docker compose (cámbielos si ya están ocupados)
API_HOST_PORT=8080
WEB_HOST_PORT=8081
MAIL_UI_HOST_PORT=8025
